
/* =========================================================
   OBSIDIAN ROYALE
   European Roulette — Textual TUI
   ========================================================= */


/* ==================== FOUNDATION ==================== */

Screen {
    layout: vertical;
    align: center top;

    background: #080D14;
    color: #F0EDE5;

    padding: 0;
    overflow-y: auto;

    scrollbar-background: #101923;
    scrollbar-color: #A58B58;
    scrollbar-color-hover: #E8C477;
}


/* ==================== HEADER ==================== */

Header {
    background: #121D27;
    color: #F5D58C;

    text-style: bold;
    border-bottom: heavy #B99755;

    height: 2;
}

Footer {
    background: #121D27;
    color: #AEBBBE;

    border-top: solid #6D5938;
    height: 1;
}


/* ==================== PLAYER BALANCE ==================== */

#balance {
    width: 76;
    max-width: 95%;
    height: 3;

    margin: 0;
    padding: 0 1;

    background: #17232D;
    color: #F7D78D;

    border: double #B99755;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}


/* ==================== SPIN RESULT ==================== */

#result {
    width: 76;
    max-width: 95%;
    height: auto;
    min-height: 3;

    margin: 0;
    padding: 0 1;

    background: #101F23;
    color: #F2E9D2;

    border: round #3C8E77;

    text-style: bold;
    text-align: center;
    content-align: center middle;
}

/* Winning spin */
#result.win {
    background: #10352C;
    color: #72F5BA;
    border: double #32D99C;
}

/* Losing spin */
#result.loss {
    background: #321A23;
    color: #FF8E9B;
    border: double #DC5361;
}

/* ==================== FORM CONTROLS ==================== */

Select,
Input {
    width: 76;
    max-width: 95%;

    height: 3;
    margin: 0 0 1 0;

    background: #18242F;
    color: #F0EDE5;
}


/* ==================== BET TYPE SELECT ==================== */

#select_bet_type {
    height: 3;
    background: #18242F;
}

#select_bet_type > SelectCurrent {
    height: 3;

    background: #18242F;
    color: #F5D58C;

    border: tall #775F3D;
    padding: 0 2;

    text-style: bold;

    transition: background 200ms, color 200ms;
}

#select_bet_type:hover > SelectCurrent {
    background: #243442;
    border: tall #D5B36F;
}

#select_bet_type:focus > SelectCurrent {
    background: #2A3540;
    border: tall #F5D58C;
}

#select_bet_type > SelectOverlay {
    background: #16232E;
    color: #F0EDE5;

    border: round #D5B36F;
    max-height: 12;
}


/* ==================== AMOUNT INPUT ==================== */

#input_bet_amount {
    background: #18242F;
    color: #F0EDE5;

    border: tall #415564;

    transition: background 200ms;
}

#input_bet_amount:hover {
    background: #202E3A;
    border: tall #8796A0;
}

#input_bet_amount:focus {
    background: #273440;
    border: tall #F5D58C;
    color: #FFFFFF;
}


/* ==================== BUTTON FOUNDATION ==================== */

Button {
    width: 76;
    max-width: 95%;

    height: 3;
    margin: 0 0 1 0;

    text-style: bold;


}


/* ==================== CONFIRM BET ==================== */

#bet {
    background: #194B40;
    color: #DDFCED;

    border: tall #38B995;
}

#bet:hover {
    background: #24735A;
    color: #FFFFFF;

    border: tall #75EFC2;
}

#bet:focus {
    background: #226D54;
    color: #FFFFFF;

    border: double #A1FFCF;
}


/* ==================== SPIN BUTTON ==================== */

#spin {
    height: 3;

    margin: 0 0 1 0;

    background: #A92F43;
    color: #FFF0DC;

    border: double #E8C477;

    text-style: bold;
}

#spin:hover {
    background: #DA4259;
    color: #FFFFFF;

    border: double #FFE4A5;
}

#spin:focus {
    background: #C8374F;
    color: #FFFFFF;

    border: double #FFE4A5;
}


/* ==================== DISABLED STATES ==================== */

Button:disabled {
    background: #252C33;
    color: #69747A;

    border: tall #39424A;
}

Input:disabled {
    background: #121920;
    color: #6D777E;

    border: tall #303941;
}

/* Interactive casino layout */
#content { height: 1fr; align-horizontal: center; padding: 0 1; }
#table-scroll { width: 100%; max-width: 88; height: 17; overflow-x: auto; overflow-y: hidden; }
RouletteTable { width: 84; height: 15; }
#table-layout { width: 84; height: 9; }
#number-grid { grid-size: 12 3; grid-columns: 6; grid-rows: 3; width: 72; height: 9; }
RouletteTable Button { width: 6; min-width: 6; max-width: 6; height: 3; margin: 0; padding: 0; border: solid #415564; color: #FFFFFF; }
#roulette-table Button.red { background: #A92F43; }
#roulette-table Button.black { background: #121D27; }
#roulette-table Button.green { background: #17684E; height: 9; }
RouletteTable Button:hover, RouletteTable Button:focus { border: heavy #F5D58C; tint: #F5D58C 15%; }
RouletteTable Button.selected { border: double #F5D58C; text-style: bold reverse; }
#bet-form { height: auto; width: 76; max-width: 95%; }
#bet-form Input, #bet-form Select, #bet-form Button { width: 100%; max-width: 100%; margin: 0; }
#roulette-wheel { width: 75; min-width: 75; max-width: 75; height: 31; border: round #B99755; content-align: center middle; background: #080D14; }

#outside-bets { width: 72; height: 3; margin-left: 6; }
#outside-bets Button { width: 12; min-width: 12; max-width: 12; }

/* Multi-bet draft and accepted bets */
#draft-selection, #draft-cost { height: auto; min-height: 1; color: #F5D58C; padding: 0 1; }
#bet-cart { width: 76; max-width: 95%; height: auto; border: round #A58B58; background: #17232D; margin: 1 0; }
.cart-title { height: 1; text-style: bold; color: #F5D58C; text-align: center; }
.cart-empty, .cart-total { height: auto; min-height: 1; padding: 0 1; }
.cart-total { color: #F5D58C; }
.cart-row { height: 3; }
.cart-row Static { width: 1fr; height: 3; content-align: left middle; padding: 0 1; }
#bet-cart .remove-bet { width: 5; min-width: 5; max-width: 5; height: 3; margin: 0; background: #A92F43; color: #FFFFFF; }

#wheel-scroll { width: 100%; max-width: 78; height: 33; overflow-x: auto; overflow-y: hidden; align-horizontal: center; }

/* Dedicated spin view: no form, balance or early settlement information. */
#spin-view { display: none; height: 1fr; padding: 0 1; align-horizontal: center; }
Screen.spinning #content, Screen.spinning Header { display: none; }
Screen.spinning #spin-view { display: block; }
#spinning-bets { width: 76; max-width: 95%; height: auto; padding: 1 2; border: round #A58B58; background: #17232D; color: #F5D58C; }

#column-bets { grid-size: 1 3; grid-rows: 3; width: 6; height: 9; }
#dozen-bets { width: 72; height: 3; margin-left: 6; }
#dozen-bets Button { width: 24; min-width: 24; max-width: 24; }
#roulette-table Button.group, #roulette-table Button.low, #roulette-table Button.high, #roulette-table Button.even, #roulette-table Button.odd { background: #518241; }
#select_bet_group { display: none; }
